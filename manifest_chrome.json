{
	"manifest_version": 3,
	"name": "Claude QoL - Export, Fork, Search, and more",
	"version": "2.9.2",
	"description": "Collection of Claude enhancements: Exporting/Importing chats, Forking, Chat Search, Bookmarks, TTS, and more.",
	"permissions": [
		"storage"
	],
	"host_permissions": [
		"https://claude.ai/*",
		"https://api.elevenlabs.io/*",
		"https://api.openai.com/*"
	],
	"content_scripts": [
		{
			"matches": [
				"https://claude.ai/*"
			],
			"js": [
				"lib/dexie.min.js",
				"lib/jszip.min.js",
				"lib/mime.min.js",
				"lib/marked.min.js",
				"lib/highlight.min.js",
				"common/i18n/en.js",
				"common/i18n/fr.js",
				"common/i18n/de.js",
				"common/i18n/hi.js",
				"common/i18n/id.js",
				"common/i18n/it.js",
				"common/i18n/ja.js",
				"common/i18n/ko.js",
				"common/i18n/pt-BR.js",
				"common/i18n/es.js",
				"content/i18n/en.js",
				"content/i18n/fr.js",
				"content/i18n/de.js",
				"content/i18n/hi.js",
				"content/i18n/id.js",
				"content/i18n/it.js",
				"content/i18n/ja.js",
				"content/i18n/ko.js",
				"content/i18n/pt-BR.js",
				"content/i18n/es.js",
				"content/helpers/i18n-migrate.js",
				"common/i18n/i18n-core.js",
				"common/ui/components.js",
				"common/ui/cards.js",
				"content/helpers/toolbox-ui.js",
				"content/helpers/header-buttons.js",
				"content/helpers/message-ui.js",
				"content/helpers/claude-api.js",
				"content/helpers/settings.js",
				"content/helpers/databases.js",
				"content/helpers/tts-providers.js",
				"content/isolated/chat-search.js",
				"content/isolated/navigation.js",
				"content/isolated/pref-switcher.js",
				"content/isolated/tts.js",
				"content/isolated/image-gallery.js",
				"content/isolated/exporter.js",
				"content/isolated/notifications.js",
				"content/isolated/banner-watcher.js",
				"content/isolated/rich-copy.js",
				"content/isolated/language.js"
			],
			"run_at": "document_idle"
		},
		{
			"matches": [
				"https://claude.ai/*"
			],
			"js": [
				"content/main/extra-models.js",
				"lib/jszip.min.js",
				"lib/mime.min.js",
				"common/i18n/en.js",
				"common/i18n/fr.js",
				"common/i18n/de.js",
				"common/i18n/hi.js",
				"common/i18n/id.js",
				"common/i18n/it.js",
				"common/i18n/ja.js",
				"common/i18n/ko.js",
				"common/i18n/pt-BR.js",
				"common/i18n/es.js",
				"content/i18n/en.js",
				"content/i18n/fr.js",
				"content/i18n/de.js",
				"content/i18n/hi.js",
				"content/i18n/id.js",
				"content/i18n/it.js",
				"content/i18n/ja.js",
				"content/i18n/ko.js",
				"content/i18n/pt-BR.js",
				"content/i18n/es.js",
				"content/helpers/i18n-migrate.js",
				"common/i18n/i18n-core.js",
				"common/ui/components.js",
				"content/helpers/toolbox-ui.js",
				"content/helpers/header-buttons.js",
				"content/helpers/message-ui.js",
				"content/helpers/claude-api.js",
				"content/helpers/settings.js",
				"content/main/phantom-messages.js",
				"content/main/forking.js",
				"content/main/edit-files.js",
				"content/main/file-download.js",
				"content/main/pref-switcher-fetch-watcher.js",
				"content/main/skill-interceptor.js",
				"content/main/tts-interceptor.js",
				"content/main/tts-ws-interceptor.js",
				"content/main/image-extractor.js",
				"lib/marked.min.js",
				"content/main/rich-copy-interceptor.js"
			],
			"world": "MAIN",
			"run_at": "document_start"
		}
	],
	"background": {
		"service_worker": "background.js"
	},
	"icons": {
		"512": "icon512.png",
		"128": "icon128.png"
	},
	"action": {
		"default_icon": {
			"16": "icon128.png",
			"32": "icon128.png",
			"128": "icon128.png"
		},
		"default_title": "Claude QoL - Support development"
	},
	"web_accessible_resources": [
		{
			"resources": [
				"common/assets/kofi-button.png",
				"common/assets/rate-badge.png",
				"update_patchnotes.txt",
				"html_template/export-template.css",
				"html_template/export-template.js"
			],
			"matches": [
				"https://claude.ai/*"
			]
		}
	]
}